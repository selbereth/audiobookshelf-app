{
  "name": "audiobookshelf-app",
  "version": "0.14.2-beta",
  "author": "advplyr",
  "scripts": {
    "dev": "nuxt --hostname 0.0.0.0 --port 1337",
    "build": "nuxt build",
    "start": "nuxt --hostname 0.0.0.0 --port 1337",
    "generate": "nuxt generate",
    "sync": "npm run build:tts-headless && nuxt generate && npx cap sync",
    "icons-android": "cordova-res android --skip-config --copy",
    "ionic:build": "npm run build",
    "ionic:serve": "npm run dev",
    "devlive": "ionic cap run -l --external --port=1337",
    "build:tts-headless": "esbuild utils/tts/headless/entry.js --bundle --minify --target=chrome100 --define:process.env.NODE_ENV='\"production\"' --alias:@/plugins/capacitor=./utils/tts/headless/capacitor-shim.js --alias:@=. --outfile=android/app/src/main/assets/tts-headless/bundle.js && cp utils/tts/headless/index.html android/app/src/main/assets/tts-headless/index.html"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^7.0.0",
    "@capacitor-community/volume-buttons": "^7.0.0",
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/browser": "^7.0.0",
    "@capacitor/clipboard": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/dialog": "^7.0.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/network": "^7.0.0",
    "@capacitor/preferences": "^7.0.0",
    "@capacitor/status-bar": "^7.0.6",
    "@nuxtjs/axios": "^5.13.6",
    "@teckel/vue-pdf": "^4.3.5",
    "@webnativellc/capacitor-filesharer": "7.0.4",
    "buffer": "^6.0.3",
    "cordova-plugin-screen-orientation": "^3.0.4",
    "core-js": "^3.15.1",
    "date-fns": "^2.25.0",
    "epubjs": "0.3.88",
    "fast-average-color": "^9.3.0",
    "libarchive.js": "^1.3.0",
    "nuxt": "^2.15.7",
    "socket.io-client": "^4.1.3",
    "v-click-outside": "^3.2.0",
    "vue-toastification": "^1.7.11",
    "vuedraggable": "^2.24.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "autoprefixer": "^10.4.17",
    "esbuild": "^0.24.2",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1"
  }
}
